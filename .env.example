# ── Required ────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=            # required for Qdrant Cloud

# ── Retrieval ───────────────────────────────────────────
# RERANKER=auto              # auto | cohere | cross-encoder | bm25 | none
# COHERE_API_KEY=            # enables the Cohere reranker (auto picks it up)
# COHERE_RERANK_MODEL=rerank-v3.5
# CANDIDATE_K=30             # candidates fetched before reranking
# TOP_K=8

# ── Models ──────────────────────────────────────────────
# DEFAULT_MODEL=anthropic/claude-3.5-sonnet
# TRANSLATION_MODEL=anthropic/claude-3.5-haiku   # Hindi/Marathi/Tamil... -> English for retrieval
# JUDGE_MODEL=anthropic/claude-3.5-sonnet        # evaluation only

# ── Embeddings (changing the model needs a full re-ingest) ──
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_QUERY_PREFIX=    # e.g. "query: " for E5 models
# EMBEDDING_DOC_PREFIX=      # e.g. "passage: " for E5 models

# ── Ingestion at scale ──────────────────────────────────
# QDRANT_ON_DISK=1
# QDRANT_QUANTIZE=1
# INGEST_RECREATE=0          # non-interactive: 1 = recreate, 0 = keep

# ── Server ──────────────────────────────────────────────
# PORT=8000
# CORS_ORIGINS=https://your-frontend.example.com
